+      draw->AddLine(project({center[0]-extent/2,lo[1]-0.03f,center[2]+offset}),project({center[0]+extent/2,lo[1]-0.03f,center[2]+offset}),IM_COL32(55,85,110,65));
+    }
+    const std::array<ImU32,3> colors{IM_COL32(255,100,110,255),IM_COL32(100,230,155,255),IM_COL32(90,155,255,255)};
+    const char* labels[3]={"X","Y","Z"};
+    for(int j=0;j<3;++j){V end=origin;end[j]+=axis;draw->AddLine(project(origin),project(end),colors[j],1.5f);draw->AddText(project(end),colors[j],labels[j]);}
