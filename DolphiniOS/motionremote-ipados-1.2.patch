+// SPDX-License-Identifier: GPL-2.0-or-later
+import Foundation
+import UIKit
+import UniformTypeIdentifiers
+
+@objc private protocol JITExtensionFactory {
+  @objc(extensionWithIdentifier:error:)
+  func find(withIdentifier identifier: String) throws -> AnyObject
+}
+@objc private protocol JITExtension {
+  @objc(beginExtensionRequestWithInputItems:completion:)
+  func begin(withInputItems items: [Any], completion: @escaping (NSUUID?) -> Void)
+  @objc(setRequestCompletionBlock:)
+  func onCompletion(_ block: @escaping (NSUUID?, [Any]?) -> Void)
+  @objc(setRequestCancellationBlock:)
+  func onCancellation(_ block: @escaping (NSUUID?, NSError?) -> Void)
+  @objc(setRequestInterruptionBlock:)
+  func onInterruption(_ block: @escaping (NSUUID?) -> Void)
+}
+
+final class BuiltInJIT {
+  static let shared = BuiltInJIT()
+  static let changed = Notification.Name("BuiltInJITChanged")
+  static var enabled: Bool { !UserDefaults.standard.bool(forKey: "MotionRemoteExternalJIT") }
+  var status = "Connect LocalDevVPN, import this device's pairing file, then enable JIT."
+  private(set) var busy = false
+  private var extensionObject: AnyObject?
+  private var requestID: UUID?
+  private var debuggerTimer: Timer?
+  private var memoryReady = false
+  private var helperReady = false
+  private var memoryStarted = false
+  var pairingURL: URL {
+    FileManager.default.urls(for: .documentDirectory, in: .userDomainMask)[0]
+      .appendingPathComponent("StikJIT/pairingFile.plist")
+  }
+  var hasPairing: Bool { FileManager.default.fileExists(atPath: pairingURL.path) }
+
+  func update(_ text: String) {
+    status = text
+    NotificationCenter.default.post(name: Self.changed, object: self)
+  }
+
+  func importPairing(from url: URL) throws {
+    let scoped = url.startAccessingSecurityScopedResource()
+    defer { if scoped { url.stopAccessingSecurityScopedResource() } }
+    let data = try Data(contentsOf: url, options: .mappedIfSafe)
+    try storeJITPairing(data, at: pairingURL)
+    var file = pairingURL
+    var values = URLResourceValues(); values.isExcludedFromBackup = true
+    try file.setResourceValues(values)
+    UserDefaults.standard.set(false, forKey: "MotionRemoteExternalJIT")
+    update("Pairing file imported. Connect LocalDevVPN, then tap Enable JIT.")
+  }
+
+  func run(reset: Bool = false) {
+    guard !busy else { return }
+    guard #available(iOS 17.4, *), getenv("LC_HOME_PATH") == nil else {
+      update("Built-in JIT requires iOS 17.4 or later and does not support LiveContainer."); return
+    }
+    guard reset || hasPairing else { update("Import this device's pairing file before enabling JIT."); return }
+    let manager = JitManager.shared()
+    if !reset && manager.builtInJitReady { update("JIT is already enabled for this session."); return }
+    guard reset || manager.hasDebugEntitlement() else {
+      update("This installation is missing get-task-allow. Re-sign with development signing and keep the JIT helper extension."); return
+    }
+    let request: BuiltInJITRequest
+    do {
+      let data = reset ? nil : try Data(contentsOf: pairingURL)
+      if let data { try validateJITPairing(data) }
+      request = .init(id: UUID(), operation: reset ? "reset" : "enable", pid: getpid(), pairing: data,
+                      needsScript: manager.deviceHasTxm)
+      guard let url = Bundle.main.builtInPlugInsURL?.appendingPathComponent("MotionRemoteJITHelper.appex"),
+            let identifier = Bundle(url: url)?.bundleIdentifier else {
+        throw failure("JIT helper missing. Reinstall this IPA and keep its app extension when signing.")
+      }
+      if NSClassFromString("NSExtension") == nil {
+        dlopen("/System/Library/Frameworks/ExtensionFoundation.framework/ExtensionFoundation", RTLD_NOW)
+      }
+      guard let type = NSClassFromString("NSExtension") else { throw failure("iOS could not load the extension API.") }
+      let factory = unsafeBitCast(type as AnyObject, to: JITExtensionFactory.self)
+      let object = try factory.find(withIdentifier: identifier)
+      let shim = unsafeBitCast(object, to: JITExtension.self)
+      let item = NSExtensionItem()
+      item.userInfo = [BuiltInJITRequest.key: try JSONEncoder().encode(request)]
+      busy = true; extensionObject = object; requestID = request.id
+      memoryReady = reset; helperReady = false; memoryStarted = false
+      if !reset {
+        manager.usingBuiltInJit = true; manager.builtInJitReady = false; manager.acquisitionError = nil
+        UserDefaults.standard.set(false, forKey: "MotionRemoteExternalJIT")
+      }
+      update(reset ? "Resetting Developer Disk Image cache…" : "Preparing device and enabling JIT… The first DDI download can take several minutes. Keep DolphiniOS open.")
+      shim.onCompletion { [weak self] _, items in
+        let data = (items?.first as? NSExtensionItem)?.userInfo?[BuiltInJITResponse.key] as? Data
+        DispatchQueue.main.async {
+          guard let self, self.requestID == request.id else { return }
+          guard let data, let response = try? JSONDecoder().decode(BuiltInJITResponse.self, from: data),
+                response.id == request.id else { self.finish("The JIT helper returned an invalid response."); return }
+          guard response.success else { self.finish(response.message); return }
+          if reset { self.finish(response.message); return }
+          self.helperReady = true
+          self.checkDebugger()
+          self.completeIfReady()
+        }
+      }
+      shim.onCancellation { [weak self] _, error in
+        DispatchQueue.main.async {
+          guard self?.requestID == request.id else { return }
+          self?.finish(error?.localizedDescription ?? "The JIT helper was cancelled.")
+        }
+      }
+      shim.onInterruption { [weak self] _ in
+        DispatchQueue.main.async {
+          guard self?.requestID == request.id else { return }
+          self?.finish("The JIT helper stopped unexpectedly. Keep LocalDevVPN connected and try again.")
+        }
+      }
+      shim.begin(withInputItems: [item]) { [weak self] uuid in
+        DispatchQueue.main.async {
+          guard let self, self.requestID == request.id else { return }
+          guard uuid != nil else { self.finish("iOS could not start the JIT helper. Check that your signer kept the app extension."); return }
+          if !reset {
+            self.debuggerTimer = Timer.scheduledTimer(withTimeInterval: 0.2, repeats: true) { [weak self] _ in self?.checkDebugger() }
+          }
+        }
+      }
+    } catch { finish(error.localizedDescription) }
+  }
+
+  private func checkDebugger() {
+    guard busy, !memoryStarted, JitManager.shared().isBuiltInDebuggerAttached() else { return }
+    memoryStarted = true
+    debuggerTimer?.invalidate(); debuggerTimer = nil
+    let id = requestID
+    update("Debugger connected. Preparing Dolphin's executable memory…")
+    DispatchQueue.global(qos: .userInitiated).async {
+      let success = JitManager.shared().prepareBuiltInJitMemory()
+      DispatchQueue.main.async {
+        guard self.requestID == id else { return }
+        guard success else { self.finish("Dolphin could not prepare executable memory. Restart DolphiniOS before retrying."); return }
+        self.memoryReady = true
+        self.completeIfReady()
+      }
+    }
+  }
+  private func completeIfReady() {
+    guard memoryReady, helperReady else { return }
+    let manager = JitManager.shared()
+    manager.builtInJitReady = true
+    manager.recheckIfJitIsAcquired()
+    finish(manager.acquiredJit ? "JIT enabled. You can start a game." : "The debugger did not enable JIT. Check your signing entitlements.")
+  }
+  private func finish(_ message: String) {
+    debuggerTimer?.invalidate(); debuggerTimer = nil
+    busy = false; requestID = nil; extensionObject = nil
+    update(message)
+  }
+  private func failure(_ message: String) -> NSError {
+    NSError(domain: "BuiltInJIT", code: 1, userInfo: [NSLocalizedDescriptionKey: message])
+  }
+}
+
+final class BuiltInJITViewController: UITableViewController, UIDocumentPickerDelegate {
+  private let jit = BuiltInJIT.shared
+  private var observer: NSObjectProtocol?
+  init() { super.init(style: .insetGrouped) }
+  required init?(coder: NSCoder) { fatalError("Use init()") }
+  override func viewDidLoad() {
+    super.viewDidLoad()
+    title = "JIT Setup"
+    navigationItem.rightBarButtonItem = UIBarButtonItem(barButtonSystemItem: .done, target: self, action: #selector(close))
+    observer = NotificationCenter.default.addObserver(forName: BuiltInJIT.changed, object: nil, queue: .main) { [weak self] _ in self?.tableView.reloadData() }
+  }
+  deinit { if let observer { NotificationCenter.default.removeObserver(observer) } }
+  @objc private func close() { dismiss(animated: true) }
+  override func numberOfSections(in tableView: UITableView) -> Int { 2 }
+  override func tableView(_ tableView: UITableView, numberOfRowsInSection section: Int) -> Int { section == 0 ? 1 : 4 }
+  override func tableView(_ tableView: UITableView, titleForHeaderInSection section: Int) -> String? {
+    section == 0 ? "Built-in StikJIT" : "Setup"
+  }
+  override func tableView(_ tableView: UITableView, titleForFooterInSection section: Int) -> String? {
+    section == 1 ? "Keep LocalDevVPN connected and allow Local Network access. Import a pairing file for this iPad. The first activation downloads a Developer Disk Image. JIT lasts until DolphiniOS closes.\n\nThe bundled helper shares this app installation; no separate StikDebug app is needed.\n\nStikJIT 2.0.1 · MPL-2.0 · github.com/StikDebug/StikJIT" : nil
+  }
+  override func tableView(_ tableView: UITableView, cellForRowAt indexPath: IndexPath) -> UITableViewCell {
+    let cell = UITableViewCell(style: .subtitle, reuseIdentifier: nil)
+    cell.textLabel?.numberOfLines = 0
+    cell.detailTextLabel?.numberOfLines = 0
+    if indexPath.section == 0 {
+      cell.textLabel?.text = jit.status
+      cell.selectionStyle = .none
+    } else {
+      cell.textLabel?.text = ["Import Pairing File", "Enable JIT", "Reset Developer Disk Image", "Use External Debugger"][indexPath.row]
+      cell.textLabel?.textColor = jit.busy ? .secondaryLabel : view.tintColor
+      cell.isUserInteractionEnabled = !jit.busy
+      if indexPath.row == 0 { cell.detailTextLabel?.text = jit.hasPairing ? "Pairing file saved on this device" : "No pairing file imported" }
+      if indexPath.row == 3 { cell.detailTextLabel?.text = "Use existing StikDebug / AltServer / JitStreamer setup" }
+    }
+    return cell
+  }
+  override func tableView(_ tableView: UITableView, didSelectRowAt indexPath: IndexPath) {
+    tableView.deselectRow(at: indexPath, animated: true)
+    guard indexPath.section == 1, !jit.busy else { return }
+    switch indexPath.row {
+    case 0:
+      let picker = UIDocumentPickerViewController(forOpeningContentTypes: [.data], asCopy: false)
+      picker.delegate = self; present(picker, animated: true)
+    case 1: jit.run()
+    case 2:
+      let alert = UIAlertController(title: "Reset Developer Disk Image?", message: "The next activation may download the DDI again. Your games, saves and pairing file are kept.", preferredStyle: .alert)
+      alert.addAction(UIAlertAction(title: "Cancel", style: .cancel))
+      alert.addAction(UIAlertAction(title: "Reset", style: .destructive) { _ in self.jit.run(reset: true) })
+      present(alert, animated: true)
+    default:
+      guard !JitManager.shared().usingBuiltInJit else {
+        jit.update("Restart DolphiniOS before switching from a built-in JIT session to an external debugger."); return
+      }
+      UserDefaults.standard.set(true, forKey: "MotionRemoteExternalJIT")
+      jit.update("External debugger selected. Enable JIT with StikDebug, or start a game to try AltServer / JitStreamer.")
+    }
+  }
+  func documentPicker(_ controller: UIDocumentPickerViewController, didPickDocumentsAt urls: [URL]) {
+    guard let url = urls.first else { return }
+    do { try jit.importPairing(from: url) } catch { jit.update(error.localizedDescription) }
+  }
+}
