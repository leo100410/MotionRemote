+- (void)configureMotionRemote {
+  UIAlertController* alert = [UIAlertController alertControllerWithTitle:@"MotionRemote" message:@"Start MotionRemote on the iPhone. Enter its Wi-Fi IPv4 address and matching player number (1–4). This configures that Wii Remote." preferredStyle:UIAlertControllerStyleAlert];
+  [alert addTextFieldWithConfigurationHandler:^(UITextField* field) {
+    field.placeholder = @"iPhone IPv4 address";
+    field.keyboardType = UIKeyboardTypeDecimalPad;
+    field.text = [[NSUserDefaults standardUserDefaults] stringForKey:@"motionremote.address"];
+  }];
+  [alert addTextFieldWithConfigurationHandler:^(UITextField* field) {
+    field.placeholder = @"Player 1–4";
+    field.keyboardType = UIKeyboardTypeNumberPad;
+    field.text = [[NSUserDefaults standardUserDefaults] stringForKey:@"motionremote.player"] ?: @"1";
+  }];
+  [alert addAction:[UIAlertAction actionWithTitle:@"Cancel" style:UIAlertActionStyleCancel handler:nil]];
+  for (NSNumber* overlay in @[@NO, @YES]) {
+    [alert addAction:[UIAlertAction actionWithTitle:overlay.boolValue ? @"Apply with 3D overlay" : @"Apply" style:UIAlertActionStyleDefault handler:^(UIAlertAction* action) {
+      NSString* address = [alert.textFields[0].text stringByTrimmingCharactersInSet:NSCharacterSet.whitespaceAndNewlineCharacterSet];
+      NSString* player = [alert.textFields[1].text stringByTrimmingCharactersInSet:NSCharacterSet.whitespaceAndNewlineCharacterSet];
+      struct in_addr parsed;
+      if (inet_pton(AF_INET,address.UTF8String,&parsed) != 1 || ![@[@"1",@"2",@"3",@"4"] containsObject:player]) {
+        UIAlertController* error = [UIAlertController alertControllerWithTitle:@"Check address and player" message:@"Use the iPhone’s IPv4 address and a player number from 1 to 4." preferredStyle:UIAlertControllerStyleAlert];
+        [error addAction:[UIAlertAction actionWithTitle:@"OK" style:UIAlertActionStyleDefault handler:nil]];
+        [self presentViewController:error animated:YES completion:nil];
+        return;
+      }
+      [self applyMotionRemoteAddress:address player:player.intValue overlay:overlay.boolValue];
+    }]];
+  }
+  [self presentViewController:alert animated:YES completion:nil];
+}
+
+- (void)applyMotionRemoteAddress:(NSString*)address player:(int)player overlay:(BOOL)overlay {
+  const int slot = player-1;
+  const std::string name = slot == 0 ? "MotionRemote" : "MotionRemote P"+std::to_string(player);
+  namespace DSU = ciface::DualShockUDPClient;
+  {
+  auto lock = ControllerEmu::EmulatedController::GetStateLock();
+  auto* config = Wiimote::GetConfig();
+  auto* controller = config->GetController(slot);
+  const std::string backup = File::GetUserPath(D_CONFIG_IDX)+"MotionRemote-Wiimote"+std::to_string(player)+"-backup.ini";
+  if (!File::Exists(backup)) {
+    Common::IniFile previous;
+    controller->SaveConfig(previous.GetOrCreateSection("Profile"));
+    if (!previous.Save(backup)) {
+      UIAlertController* error = [UIAlertController alertControllerWithTitle:@"Settings could not be saved" message:@"The existing controller settings could not be backed up. Check available storage and try again." preferredStyle:UIAlertControllerStyleAlert];
+      [error addAction:[UIAlertAction actionWithTitle:@"OK" style:UIAlertActionStyleDefault handler:nil]];
+      [self presentViewController:error animated:YES completion:nil];
+      return;
+    }
+  }
+  Common::IniFile profile;
+  auto* section = profile.GetOrCreateSection("Profile");
+  section->Set("Device","DSUClient/"+std::to_string(slot)+"/"+name);
+  section->Set("Extension",std::string("None"));
+  section->Set("IMUIR/Enabled",std::string("True"));
+  section->Set("IMUIR/Recenter",std::string("`R3`"));
+  section->Set("Buttons/A",std::string("`Cross`"));
+  section->Set("Buttons/B",std::string("`Circle`"));
+  section->Set("Buttons/1",std::string("`Square`"));
+  section->Set("Buttons/2",std::string("`Triangle`"));
+  section->Set("Buttons/-",std::string("`L1`"));
+  section->Set("Buttons/+",std::string("`R1`"));
+  section->Set("Buttons/Home",std::string("`PS`"));
+  section->Set("D-Pad/Up",std::string("`Pad N`"));
+  section->Set("D-Pad/Down",std::string("`Pad S`"));
+  section->Set("D-Pad/Left",std::string("`Pad W`"));
+  section->Set("D-Pad/Right",std::string("`Pad E`"));
+  section->Set("IMUAccelerometer/Up",std::string("`Accel Up`"));
+  section->Set("IMUAccelerometer/Down",std::string("`Accel Down`"));
+  section->Set("IMUAccelerometer/Left",std::string("`Accel Left`"));
+  section->Set("IMUAccelerometer/Right",std::string("`Accel Right`"));
+  section->Set("IMUAccelerometer/Forward",std::string("`Accel Forward`"));
+  section->Set("IMUAccelerometer/Backward",std::string("`Accel Backward`"));
+  section->Set("IMUGyroscope/Pitch Up",std::string("`Gyro Pitch Up`"));
+  section->Set("IMUGyroscope/Pitch Down",std::string("`Gyro Pitch Down`"));
+  section->Set("IMUGyroscope/Roll Left",std::string("`Gyro Roll Left`"));
+  section->Set("IMUGyroscope/Roll Right",std::string("`Gyro Roll Right`"));
+  section->Set("IMUGyroscope/Yaw Left",std::string("`Gyro Yaw Left`"));
+  section->Set("IMUGyroscope/Yaw Right",std::string("`Gyro Yaw Right`"));
+  section->Set("Rumble/Motor",std::string("`Motor`"));
+  section->Set("IMUIR/Preserve Angle",std::string("True"));
+  controller->LoadConfig(section);
+  controller->UpdateReferences(g_controller_interface);
+  config->SaveConfig();
+  }
+  Config::SetBaseOrCurrent(Config::GetInfoForWiimoteSource(slot),WiimoteSource::Emulated);
+  std::stringstream entries(Config::Get(DSU::Settings::SERVERS));
+  std::string entry,updated;
+  while (std::getline(entries,entry,';')) {
+    if (!entry.empty() && !entry.starts_with(name+":")) updated += entry+";";
+  }
+  updated += name+":"+address.UTF8String+":26760;";
+  Config::SetBaseOrCurrent(DSU::Settings::SERVERS,updated);
+  Config::SetBaseOrCurrent(DSU::Settings::SERVERS_ENABLED,true);
+  Config::Save();
+  DSU::MotionRemote::enabled.store(overlay);
+  DSU::MotionRemote::selected.store(slot);
+  [[NSUserDefaults standardUserDefaults] setObject:address forKey:@"motionremote.address"];
+  [[NSUserDefaults standardUserDefaults] setObject:[NSString stringWithFormat:@"%d",player] forKey:@"motionremote.player"];
+  UIAlertController* ready = [UIAlertController alertControllerWithTitle:@"MotionRemote configured" message:@"Open a Wii game to start receiving the iPhone’s buttons and motion. Enable JIT from Settings → JIT. Use the iPhone crosshair to recenter." preferredStyle:UIAlertControllerStyleAlert];
+  [ready addAction:[UIAlertAction actionWithTitle:@"OK" style:UIAlertActionStyleDefault handler:nil]];
+  [self presentViewController:ready animated:YES completion:nil];
+}
+
 @end
