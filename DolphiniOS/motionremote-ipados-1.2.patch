+      const float phone_scale=std::min(0.65f,32*ui/(scale*0.17f));
+      const std::array<V,8> box{{{-0.037f,-0.075f,-0.004f},{0.037f,-0.075f,-0.004f},{0.037f,0.075f,-0.004f},{-0.037f,0.075f,-0.004f},
+                               {-0.037f,-0.075f,0.004f},{0.037f,-0.075f,0.004f},{0.037f,0.075f,0.004f},{-0.037f,0.075f,0.004f}}};
