+inline void ApplyCameraPointer(IMUCursorState* state, const std::array<float,4>& pose,
+ unsigned epoch, bool valid, bool recenter, float max_yaw, float dt) {
+ if (state->camera_epoch != epoch) {state->camera_centered=false;state->camera_epoch=epoch;}
+ state->camera_valid=valid && state->camera_centered;
+ if (!valid) return;
+ const Common::Quaternion camera(pose[3],pose[0],pose[1],pose[2]);
+ if (recenter) {state->camera_reference=camera;state->camera_centered=true;state->recentered_pitch=0;}
+ if (!state->camera_centered) return;
+ state->camera_valid=true;
+ const auto relative=state->camera_reference.Inverted()*camera;
+ // Match DSU -> IMUGyroscope -> negative gyro integration: (+X, +Y, -Z).
+ const auto& q=relative.data;
+ const Common::Quaternion target(q.w,q.x,q.y,-q.z);
+ auto current=state->tracked_rotation;
+ float dot=current.data.Dot(target.data);
+ auto end=target.data;
+ if(dot<0) {end=end*-1;dot=-dot;}
+ dot=std::clamp(dot,0.f,1.f);
+ const float weight=1-std::exp(-dt/0.1f);
+ float a=1-weight,b=weight;
+ if(dot<=0.9995f) {const float angle=std::acos(dot);a=std::sin((1-weight)*angle)/std::sin(angle);b=std::sin(weight*angle)/std::sin(angle);}
+ current=Common::Quaternion(current.data.w*a+end.w*b,current.data.x*a+end.x*b,current.data.y*a+end.y*b,current.data.z*a+end.z*b);
+ state->tracked_rotation=current.Normalized();state->rotation=state->tracked_rotation;
+ const float yaw=GetYaw(state->rotation);
+ state->rotation*=Common::Quaternion::RotateZ(std::clamp(yaw,-max_yaw,max_yaw)-yaw);
+}
+}
