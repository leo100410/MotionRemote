+// MotionRemote diagnostics in Dolphin's Logs folder: one line per event, repeats of a key are counted, not written.
+namespace MRLog
+{
+inline std::mutex mutex;
+inline std::ofstream file;
+inline std::map<std::string,std::pair<double,int>> recent;
+inline void Open(const std::string& path)
+{
+  std::lock_guard lock(mutex);
+  if(file.is_open())return;
+  std::rename(path.c_str(),(path.substr(0,path.size()-4)+"-previous.log").c_str());
+  file.open(path,std::ios::out|std::ios::trunc);
+}
+inline void Write(double now,const std::string& category,const std::string& message,const std::string& key={},double every=1)
+{
+  std::lock_guard lock(mutex);
+  std::string text=message;
+  if(!key.empty())
+  {
+    auto it=recent.find(key);
+    if(it!=recent.end() && now-it->second.first<every) {++it->second.second;return;}
+    if(it!=recent.end() && it->second.second>0)text+=" (+"+std::to_string(it->second.second)+" similar since the last line)";
+    recent[key]={now,0};
+  }
+  if(!file.is_open())return;
+  const auto wall=std::chrono::system_clock::now();
+  const std::time_t seconds=std::chrono::system_clock::to_time_t(wall);
+  const int ms=int(std::chrono::duration_cast<std::chrono::milliseconds>(wall.time_since_epoch()).count()%1000);
+  std::tm local{};localtime_r(&seconds,&local);
+  char stamp[32];std::snprintf(stamp,sizeof(stamp),"%02d:%02d:%02d.%03d",local.tm_hour,local.tm_min,local.tm_sec,ms);
+  file<<stamp<<" ["<<category<<"] "<<text<<"\n";file.flush();
+}
+inline std::string Format(const char* format,auto... values)
+{
+  char buffer[512];std::snprintf(buffer,sizeof(buffer),format,values...);return buffer;
+}
