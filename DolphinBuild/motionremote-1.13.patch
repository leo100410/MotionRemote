+- (int)freePlayerFor:(MRPeer*)peer {
+  // Phones often all keep the default player 1; each connected phone gets its own Wii Remote.
+  auto taken=[&](int player) {
+    for(MRPeer* other in self.peers)if(other!=peer && [self inUse:other] && ![other.name isEqual:peer.name] && other.player==player)return true;
+    return false;
+  };
