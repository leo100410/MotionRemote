+++ b/Source/Core/InputCommon/ControllerInterface/DualShockUDPClient/BluetoothWire.h	2026-11-12 11:49:17
@@ -0,0 +1,38 @@
+#pragma once
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include <cstdint>
+#include <vector>
+#include <map>
+#include <optional>
+#include <utility>
+#include <algorithm>
+namespace MRWire {
+using Bytes=std::vector<std::uint8_t>;
+inline std::vector<Bytes> Frames(const Bytes& data,std::uint8_t route,std::uint8_t sequence,std::size_t mtu) {
+  if(route>=16 || data.empty() || data.size()>1024 || mtu<=4)return {};
+  const auto size=mtu-4,count=(data.size()+size-1)/size;
+  if(count>64)return {};
+  std::vector<Bytes> result;
+  for(std::size_t i=0;i<count;++i) {
+    Bytes frame{route,sequence,static_cast<std::uint8_t>(i),static_cast<std::uint8_t>(count)};
+    frame.insert(frame.end(),data.begin()+i*size,data.begin()+std::min(data.size(),(i+1)*size));result.push_back(std::move(frame));
+  }
+  return result;
+}
+class Decoder {
+  struct Part {std::uint8_t id,count,next;double time;Bytes data;};
+  std::map<std::uint8_t,Part> parts;
+public:
+  std::optional<std::pair<std::uint8_t,Bytes>> Accept(const Bytes& b,double now) {
+    if(b.size()<=4 || b[0]>=16 || b[3]==0 || b[3]>64 || b[2]>=b[3])return {};
+    std::erase_if(parts,[now](const auto& p){return now-p.second.time>=0.25;});
+    if(b[2]==0)parts[b[0]]={b[1],b[3],0,now,{}};
+    auto it=parts.find(b[0]);if(it==parts.end())return {};
+    auto& p=it->second;
+    if(p.id!=b[1] || p.count!=b[3] || p.next!=b[2] || p.data.size()+b.size()-4>1024) {parts.erase(it);return {};}
+    p.data.insert(p.data.end(),b.begin()+4,b.end());++p.next;
+    if(p.next==p.count) {auto result=std::make_pair(b[0],std::move(p.data));parts.erase(it);return result;}
+    return {};
+  }
+};
+}
