+      if(received<20) {self.recommendation=@"This path is not reliable enough. Check permissions and keep both apps open; test the other transport.";[self.scores removeObjectForKey:scoreKey];return;}
+      self.scores[scoreKey]=@{@"score":@(quality.Score()),@"poor":@(quality.Poor()),@"time":@(MRNow())};
