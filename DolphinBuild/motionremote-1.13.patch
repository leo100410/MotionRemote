+// Per-phone link statistics. The phone stamps every pad packet with its sensor time, which separates
+// Wi-Fi holding packets back from packets lost on the way and from the phone itself pausing.
+struct Link
+{
+  int player=1;
+  double last=-1,summary_at=-1,stalled_since=-1,max_gap=0;
+  std::uint32_t counter=0;
+  std::uint64_t stamp=0;
+  int pads=0,lost=0,held=0,dropped=0,paused=0;
+  std::vector<double> held_times;
+  void Packet(double now,std::uint32_t number,std::uint64_t stamp_us)
+  {
+    if(summary_at<0)summary_at=now;
+    if(last>=0 && now-last<1)
+    {
+      const int missing=int(number-counter)-1;const double gap=(now-last)*1000;
+      lost+=std::max(0,missing);max_gap=std::max(max_gap,gap);
+      if(gap>80)
+      {
+        const double sent=stamp_us>stamp?double(stamp_us-stamp)/1000:0;
+        std::string cause,kind;
+        if(sent<gap/2) {++held;kind="held";held_times.push_back(now);cause=Format("phone sent them %.0f ms apart, so Wi-Fi held them back",sent);}
+        else if(missing>0) {++dropped;kind="dropped";cause="the phone kept sending, the packets were lost on the way";}
+        else {++paused;kind="paused";cause=Format("the phone itself paused sending for %.0f ms",sent);}
+        if(stalled_since<0)Write(now,"LINK",Format("Player %d: packet gap %.0f ms, %d lost: %s",player,gap,std::max(0,missing),cause.c_str()),"gap"+std::to_string(player)+kind);
+      }
+    }
+    if(stalled_since>=0) {Write(now,"LINK",Format("Player %d: controller data resumed after %.0f ms",player,(now-stalled_since)*1000));stalled_since=-1;}
+    last=now;counter=number;stamp=stamp_us;++pads;
+  }
+  void Tick(double now)
+  {
+    if(last>=0 && stalled_since<0 && now-last>0.4)
+    {
+      stalled_since=last;
+      Write(now,"LINK",Format("Player %d: no controller data for 400 ms (inputs are released after 250 ms). Phone app in background or locked, Wi-Fi interference, or AirDrop/Handoff active.",player));
+    }
+    if(summary_at<0 || now-summary_at<10)return;
+    const double seconds=now-summary_at;
+    if(pads>0)
+      Write(now,"SUMMARY",Format("Player %d, 10 s: %.0f pad/s · %d lost (%.1f%%) · longest gap %.0f ms · gaps > 80 ms: %d held by Wi-Fi, %d dropped by Wi-Fi, %d phone paused%s",
+                                  player,pads/seconds,lost,pads+lost>0?100.0*lost/(pads+lost):0.0,max_gap,held,dropped,paused,Rhythm(held_times).c_str()));
