+  }
+  // Wi-Fi gaps at a steady rhythm point to the radio pausing on purpose (AirDrop/Handoff scanning, power saving).
+  static std::string Rhythm(const std::vector<double>& times)
+  {
+    if(times.size()<4)return {};
+    double mean=0,spread=0;const double n=double(times.size()-1);
+    for(size_t i=1;i<times.size();++i)mean+=(times[i]-times[i-1])/n;
+    for(size_t i=1;i<times.size();++i)spread+=std::pow(times[i]-times[i-1]-mean,2)/n;
+    return std::sqrt(spread)<mean*0.2 ? Format(" (regular, every %.2f s: typical of AirDrop/Handoff radio scanning; switch both off while playing)",mean) : std::string{};
+  }
+};
+}
