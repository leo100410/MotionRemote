+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <array>
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cmath>
+#include <cstdint>
+#include <deque>
+#include <mutex>
+
+namespace ciface::DualShockUDPClient::MotionRemote
+{
+inline constexpr double HistorySeconds=3.0;
+inline std::atomic_bool enabled{false};
+inline std::atomic_int selected{0};
+inline double Now() { return std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count(); }
+struct Point { std::array<float,3> position; unsigned segment; double time; };
+struct RumblePoint { double time; float strength; };
+struct Snapshot
+{
+  double input_at=0, rumble_at=0, pose_at=0;
+  float rumble=0;
+  std::deque<RumblePoint> rumble_history;
+  std::uint32_t epoch=0, sequence=0;
+  std::uint64_t timestamp=0;
+  std::uint8_t tracking=0;
+  std::array<float,3> position{};
+  std::array<float,4> orientation{0,0,0,1};
+  std::deque<Point> trail;
+  unsigned segment=0;
+  bool break_trail=true;
+  // Pose in the phone's calibrated screen frame (packet 0x100007).
+  double screen_at=0;
+  std::uint8_t screen_tracking=0,screen_reason=0;
+  bool screen_calibrated=false;
+  std::array<float,4> screen_orientation{0,0,0,1};
+  int pointer_source=-1; // 0 gyro only, 1 camera relative to recenter, 2 screen-calibrated
+};
+// Epoch marking the screen-calibrated pointer, so the relative camera mode needs its own recenter again.
+inline constexpr unsigned ScreenEpoch=0xFFFFFFFFu;
+inline const char* ReasonText(std::uint8_t reason)
+{
+  static const char* texts[]={"Tracking normally","Starting camera tracking (move the phone slowly)","Phone moved too fast for the camera",
+    "Camera sees too little detail (dark room, blank wall or ceiling, covered lens)","Recognising the saved room","Camera tracking unavailable",
+    "Camera tracking interrupted","Camera tracking failed","Camera tracking switched off"};
+  return reason<9?texts[reason]:"Unknown tracking state";
+}
+inline std::mutex mutex;
+inline std::array<Snapshot,4> states;
+inline void Reset(int slot) { if(slot<0 || slot>=4)return; std::lock_guard lock(mutex); states[slot]=Snapshot{}; }
+inline void Input(int slot) { if(slot<0 || slot>=4)return; std::lock_guard lock(mutex); states[slot].input_at=Now(); }
+inline void Rumble(int slot,float value) {
+  if(slot<0 || slot>=4)return;
+  std::lock_guard lock(mutex);auto& s=states[slot];const auto now=Now();
+  s.rumble=std::isfinite(value)?std::clamp(value,0.0f,1.0f):0.0f;s.rumble_at=now;
+  s.rumble_history.push_back({now,s.rumble});
+  while(s.rumble_history.size()>256 || (!s.rumble_history.empty() && now-s.rumble_history.front().time>HistorySeconds))s.rumble_history.pop_front();
+}
+inline bool Pose(int slot,std::uint8_t tracking,std::uint32_t epoch,std::uint32_t sequence,std::uint64_t timestamp,
+                 std::array<float,3> position,std::array<float,4> orientation)
+{
+  if(slot<0 || slot>=4 || tracking>2)return false;
+  float norm=0;
+  for(float v:position)if(!std::isfinite(v)||std::abs(v)>1000)return false;
+  for(float v:orientation) {if(!std::isfinite(v))return false;norm+=v*v;}
+  if(!std::isfinite(norm)||norm<0.00001f)return false;
+  std::lock_guard lock(mutex);
+  auto& s=states[slot];
+  if(timestamp<=s.timestamp)return false;
+  if(epoch==s.epoch && s.timestamp!=0) { auto d=sequence-s.sequence; if(d==0 || d>=0x80000000)return false; }
+  if(epoch!=s.epoch) {s.trail.clear();s.break_trail=true;s.segment=0;}
+  const double now=Now();
+  if(now-s.pose_at>0.3)s.break_trail=true;
+  s.epoch=epoch;s.sequence=sequence;s.timestamp=timestamp;s.pose_at=now;s.tracking=tracking;
+  if(tracking!=2) {s.break_trail=true;return true;}
+  if(s.break_trail) {++s.segment;s.break_trail=false;}
+  for(float& v:orientation)v/=std::sqrt(norm);
+  s.position=position;s.orientation=orientation;
+  s.trail.push_back({position,s.segment,now});
+  while(s.trail.size()>512 || (!s.trail.empty() && now-s.trail.front().time>HistorySeconds))s.trail.pop_front();
+  return true;
+}
+inline bool Screen(int slot,std::uint8_t tracking,std::uint8_t reason,bool calibrated,std::array<float,4> orientation)
+{
+  if(slot<0 || slot>=4 || tracking>2)return false;
+  float norm=0;
+  for(float v:orientation) {if(!std::isfinite(v))return false;norm+=v*v;}
+  if(tracking==2 && calibrated && norm<0.00001f)return false;
+  std::lock_guard lock(mutex);
+  auto& s=states[slot];
+  s.screen_at=Now();s.screen_tracking=tracking;s.screen_reason=reason;s.screen_calibrated=calibrated;
+  if(norm>=0.00001f) {for(float& v:orientation)v/=std::sqrt(norm);s.screen_orientation=orientation;}
+  return true;
+}
+// Returns the previous source so callers can report changes.
+inline int SetPointerSource(int slot,int source)
+{
+  if(slot<0 || slot>=4)return source;
+  std::lock_guard lock(mutex);
+  const int previous=states[slot].pointer_source;states[slot].pointer_source=source;return previous;
+}
+inline std::array<Snapshot,4> Read() { std::lock_guard lock(mutex); return states; }
+}
