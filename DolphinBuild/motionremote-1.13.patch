+#pragma once
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+namespace MRGyro {
+// Keeps the rotation of every sample: packets that arrive late, in a burst or twice (second
+// transport) add rate x phone time to a debt, which is paid out in bounded steps per poll.
+class Accumulator {
+public:
+  static constexpr double PollRate=200,MaxStep=10,MaxDebt=180,MaxGap=0.1,Restart=1;
+  // False for a duplicate or older packet. Times are seconds (now) and microseconds (phone).
+  bool Accept(std::uint32_t number,std::uint64_t timestamp_us,const std::array<float,3>& rate,double now) {
+    // The phone counter starts again with the app, so a silent second accepts any number.
+    const bool restart=!m_seen || now-m_last>=Restart;
+    if(!restart) {const std::uint32_t d=number-m_number;if(d==0 || d>=0x80000000u)return false;}
+    const double dt=!restart && timestamp_us>m_timestamp?std::min((timestamp_us-m_timestamp)/1e6,MaxGap):0;
+    for(int i=0;i<3;++i) {
+      m_raw[i]=std::isfinite(rate[i])?rate[i]:0;
+      m_debt[i]=std::clamp(m_debt[i]+m_raw[i]*dt,-MaxDebt,MaxDebt);
+    }
+    m_seen=true;m_number=number;m_timestamp=timestamp_us;m_last=now;return true;
+  }
+  // Degrees per second to report for one 1/PollRate step.
+  std::array<float,3> Discharge() {
+    std::array<float,3> out{};
+    for(int i=0;i<3;++i) {const double step=std::clamp(m_debt[i],-MaxStep,MaxStep);m_debt[i]-=step;out[i]=static_cast<float>(step*PollRate);}
+    return out;
+  }
+  void Clear() {m_debt={};}
+  const std::array<float,3>& Raw() const {return m_raw;}
+private:
+  std::array<double,3> m_debt{};
+  std::array<float,3> m_raw{};
+  std::uint32_t m_number=0;
+  std::uint64_t m_timestamp=0;
+  double m_last=0;
+  bool m_seen=false;
+};
+}
--- a/Source/Core/InputCommon/ControllerInterface/DualShockUDPClient/LinkQuality.h	1970-01-01 01:00:00
+++ b/Source/Core/InputCommon/ControllerInterface/DualShockUDPClient/LinkQuality.h	2026-11-12 11:53:27
@@ -0,0 +1,25 @@
+#pragma once
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include <vector>
+#include <cmath>
+namespace MRLink {
+struct Quality {
+  double average=999,jitter=0,loss=100;
+  int received=0;
+  double Score() const {return average+jitter*2+loss*5;}
+  bool Useful() const {return received>=20;}
+  bool Poor() const {return loss>5 || average>75 || jitter>30;}
+};
+inline Quality Measure(const std::vector<double>& samples,int requested) {
+  Quality q;if(requested<=0 || samples.size()>static_cast<size_t>(requested))return q;
+  double sum=0,differences=0,previous=-1;
+  for(double value:samples) {
+    if(!std::isfinite(value) || value<0)return Quality{};
+    sum+=value;if(previous>=0)differences+=std::abs(value-previous);previous=value;
+  }
+  q.received=static_cast<int>(samples.size());q.loss=100.0*(requested-q.received)/requested;
+  if(q.received)q.average=sum/q.received;
+  if(q.received>1)q.jitter=differences/(q.received-1);
+  return q;
+}
+}
