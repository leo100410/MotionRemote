+  for(int player=1;player<=4;++player)if(!taken(player))return player;
+  return 0;
+}
+- (void)connect:(MRPeer*)peer {[self connect:peer player:0];}
+// player 0 picks a free player; 1–4 takes that player from whichever phone holds it.
+- (void)connect:(MRPeer*)peer player:(int)requested {
